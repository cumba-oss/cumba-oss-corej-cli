<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-clients-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cumba-oss-cdisc-rest</artifactId>

    <name>Cumba OSS Clients :: CDISC Validation REST API</name>
    <url>https://github.com/cumba-oss/cumba-oss-clients</url>
    <packaging>jar</packaging>

    <inceptionYear>2026</inceptionYear>
    <description>
        Web service that exposes the corej CDISC validation engine over a
        session-oriented REST API (Spring Boot), with an auto-generated
        OpenAPI spec and Swagger UI via springdoc. Reuses the same engine
        wiring the CLI drives (LocalDataTableManager + LibraryValidator +
        JsonReportWriter).
    </description>

    <properties>
        <!-- Phases 2-5 reached ~91% line coverage (unit + MockMvc integration tests). Gate at
             0.85, matching the plan's per-phase target, with headroom over the achieved figure.
             The bootstrap class (CorejRestApplication.main) is the main uncovered surface. -->
        <jacoco.line.coverage>0.85</jacoco.line.coverage>
    </properties>

    <dependencies>

        <!-- Spring Boot web + the springdoc starter (OpenAPI 3 + Swagger UI in one). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- corej engine + the providers the local manager needs to read a study. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-core</artifactId>
        </dependency>

        <!-- Pluggable report writers: these two modules are what makes -of json / json-2 / xlsx
             available at runtime. They register with the engine's report SPI through
             META-INF/services and are referenced by NO import here - drop one and the format
             simply disappears from the enumerated list (Fix #224). -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-report-json</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-report-xlsx</artifactId>
        </dependency>
        <!-- Apache POI (full XSSF) — the report store renders the XLSX download via
             net.cumba.cdisc.core.report.XlsxReportWriter. Declared explicitly (not relied on
             transitively) because this module references POI types directly. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-library</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-define</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-manager-local</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-define</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-cdt</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-dsj</artifactId>
        </dependency>

        <!--
            The three providers below are referenced by NO import in this module: they register
            with the datatable SPI through META-INF/services, exactly like the report writers
            above, so dropping one silently narrows what the server can read (Fix #224's shape).
            Added in wave 38 (PLAN-reference-data-filenames-validation, W37-D1) to match
            the CLI module — before this the REST server could not open .xpt/.xlsx at all
            and a .xpt reference-data request died mid-run with a 500.

            ⚠ They are NOT interchangeable, and the asymmetry is deliberate:
              - provider-sas  registers an IProviderSupplier AND an ILibrarySupplier (XptLibrarySupplier)
              - provider-xlsx registers an IProviderSupplier AND an ILibrarySupplier (ExcelLibrarySupplier)
              - provider-parquet registers ONLY an IProviderSupplier
            ⇒ .xpt/.xls/.xlsx become valid 'referenceDataFilenames' formats; .parquet does NOT and
            stays a 400. That is F3's ruled category error (a library is a *container* of tables,
            and a single parquet file has no member namespace), not an oversight — see
            StudyValidationCheckRunner#requireLibraryFormat. Parquet buys .parquet *dataset*
            reading only, and it MEASURED 20 jars / 31.8 MB of transitive weight (parquet-mr 1.17.0
            + hadoop-common 3.4.1 + zstd-jni/snappy codecs) into the dist bundle and the Docker
            image — 98.7% of this change's +32.19 MB, against 0.42 MB for sas + xlsx combined.
        -->

        <!-- SAS Transport (.xpt) and SAS dataset (.sas7bdat) reader. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-sas</artifactId>
        </dependency>

        <!-- Excel (.xls / .xlsx) reader. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-xlsx</artifactId>
        </dependency>

        <!-- Apache Parquet (.parquet) reader. Datasets only — no library supplier. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-parquet</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-web-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- Logging backend is Logback (the Spring Boot default, pulled in transitively by the
             starters). The engine logs via java.lang.System.Logger -> JUL; Boot's jul-to-slf4j
             bridge forwards those records to SLF4J -> Logback, where RunLogDebugCapture taps the
             engine logger with a Logback appender. Do NOT add slf4j-jdk14 / log4j-to-jul here:
             a second SLF4J binding makes SLF4J bind to JUL instead of Logback, which both defeats
             RunLogDebugCapture and trips Boot's LogbackLoggingSystem "not a Logback LoggerContext"
             assertion at startup. -->

        <!-- Test: Boot test slice (JUnit 5 + assertions + Mockito) for controller/service tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 split the MockMvc/@WebMvcTest test slice into its own module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Spring MVC resolves @PathVariable/@RequestParam names from method
                         parameter names; -parameters keeps them in the bytecode (the Boot
                         starter-parent enables this by default, but we inherit cumba-oss-clients-parent). -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Opt-in spec generation. Starts the Boot app, dumps /v3/api-docs
            to target/openapi.json, then stops it. The web module's gen:api
            prefers this file when present (else its committed snapshot), so
            the generated TS types track the running API. Does NOT change the
            default build; activate with `-Pgenerate-openapi`.
        -->
        <profile>
            <id>generate-openapi</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>pre</id>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>post</id>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>dump</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <apiDocsUrl>http://localhost:8080/v3/api-docs</apiDocsUrl>
                            <outputFileName>openapi.json</outputFileName>
                            <outputDir>${project.build.directory}</outputDir>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Opt-in: bundle a built web SPA into this jar's static/ so the API serves the UI at /
            on the same origin (a single deployable). The copy is bound to prepare-package so the
            SPA lands in target/classes/static and is packaged into the (thin) jar. A missing
            dist/ is skipped with a warning, yielding an API-only jar. Does NOT change the
            default build:
              mvn -pl clients/cumba-oss-cdisc-rest -Pbundle-web clean package -Dweb.dist.dir=/path/to/dist

            ⚠ The SPA is NOT in this repository — it is published separately. In the monorepo this
            path was the sibling `../corej-cdisc-web/dist`, which does not resolve across the repo
            split, so the directory is a PROPERTY with no usable default rather than a dead
            relative path. Point `web.dist.dir` at a built dist/ to use the profile.

            (For the cross-origin alternative — a separately-hosted SPA — add a CORS
            WebMvcConfigurer bean instead of bundling.)
        -->
        <profile>
            <id>bundle-web</id>
            <properties>
                <!-- Overridden with -Dweb.dist.dir=... ; the default does not exist,
                     so the copy is skipped with a warning rather than copying junk. -->
                <web.dist.dir>${project.basedir}/web-dist-not-configured</web.dist.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-web-dist</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${web.dist.dir}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
