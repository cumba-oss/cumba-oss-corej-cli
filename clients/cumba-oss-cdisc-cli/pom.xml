<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-clients-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cumba-oss-cdisc-cli</artifactId>

    <name>Cumba OSS Clients :: CDISC Validation CLI</name>
    <url>https://github.com/cumba-oss/cumba-oss-clients</url>
    <packaging>jar</packaging>

    <inceptionYear>2026</inceptionYear>
    <description>
        Command-line tool that drives the corej engine: load a study from
        files, fetch or load a rule package, run validation, write a JSON
        report. Headless. Builds a plain jar with a Main-Class manifest
        entry plus a sibling libs/ directory so the jar runs as
        `java -jar cumba-oss-cdisc-cli-${revision}.jar`. Ships the
        dataviewer's CdiscValidate.java source verbatim.
    </description>

    <properties>
        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>
    </properties>

    <dependencies>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-manager-local</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-dsj</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-cdt</artifactId>
        </dependency>

        <!-- SAS Transport (.xpt) and SAS dataset (.sas7bdat) reader. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-sas</artifactId>
        </dependency>

        <!-- Excel (.xls / .xlsx) reader. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-xlsx</artifactId>
        </dependency>

        <!-- Apache Parquet (.parquet) reader. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-parquet</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-define</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-core</artifactId>
        </dependency>

        <!-- Pluggable report writers: these two modules are what makes -of json / json-2 / xlsx
             available at runtime. They register with the engine's report SPI through
             META-INF/services and are referenced by NO import here - drop one and the format
             simply disappears from the enumerated list (Fix #224). -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-report-json</artifactId>
        </dependency>
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-report-xlsx</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-library</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-define</artifactId>
        </dependency>

        <!-- Define-XML conformance validator, driven by the validate-xml flag. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-define-conformance</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-web-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- JSON for the remote REST client (parsing responses / building request bodies). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Command-line argument parsing. -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!-- route slf4j to JUL -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
        </dependency>

        <!-- route log4j to JUL -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-jul</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${plugin.maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>libs/</classpathPrefix>
                            <mainClass>net.cumba.dataviewer.examples.CdiscValidate</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${plugin.maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <?m2e ignore?>
                        <id>copy-runtime-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
