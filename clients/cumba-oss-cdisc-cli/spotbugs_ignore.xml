<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- ================================================================ -->
    <!-- 1. Generic project-wide FP categories                            -->
    <!--    Every instance of these patterns is structurally an FP in     -->
    <!--    this codebase by project convention. Only categories with     -->
    <!--    at least one finding in this module are listed.               -->
    <!-- ================================================================ -->

    <Match>
        <!-- THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION: CLI main(String[])
             methods declare `throws Exception` as the pragmatic top-level
             surface. -->
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    </Match>

    <!-- ================================================================ -->
    <!-- 2. Targeted suppressions                                         -->
    <!--    One <Match> per unique (class, method-or-field, bug pattern)  -->
    <!--    tuple. Multiple findings sharing the same tuple collapse into -->
    <!--    one Match (filter has no line-level scope).                   -->
    <!-- ================================================================ -->

    <Match>
        <!-- CLI mains: System.exit returns shell exit codes; the call is the
             right pragmatic surface for a CLI tool. After the §8.6 main->run
             extraction the System.exit call lives in main() rather than the
             inner run helper. -->
        <Class name="net.cumba.dataviewer.examples.CdiscValidate" />
        <Method name="main" />
        <Bug pattern="DM_EXIT" />
    </Match>

    <Match>
        <!-- Path.getFileName() chains in CdiscValidate: only null for root
             paths, unreachable for user-supplied dataset/output paths. -->
        <Class name="net.cumba.dataviewer.examples.CdiscValidate" />
        <Method name="resolveRuntimeReportPath" />
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>

    <Match>
        <!-- Same Path.getFileName() rationale for the remote-upload helpers: the data /
             define.xml / rules paths are user-supplied files that exist (checked); getFileName()
             is null only for a filesystem root, which cannot be a regular file to upload. -->
        <Class name="net.cumba.dataviewer.examples.CdiscValidate" />
        <Or>
            <Method name="uploadData" />
            <Method name="uploadNamed" />
        </Or>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>

    <Match>
        <!-- CdiscValidate.Args.compatSink: a single hidden picocli option that absorbs the
             accepted-but-ignored Python-compat flags (and the removed -dp) so the parser does not
             reject them. picocli writes the captured values into the field; the parser reads the
             raw args (not this field) to emit the ignore note / -dp error, so the field is
             write-only by design. -->
        <Class name="net.cumba.dataviewer.examples.CdiscValidate$Args" />
        <Field name="compatSink" />
        <Bug pattern="URF_UNREAD_FIELD" />
    </Match>

</FindBugsFilter>
