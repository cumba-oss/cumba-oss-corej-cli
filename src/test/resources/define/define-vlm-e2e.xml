<?xml version="1.0" encoding="UTF-8"?>
<ODM xmlns:def="http://www.cdisc.org/ns/def/v2.1" ODMVersion="1.3.2" FileType="Snapshot"
     FileOID="DEF.VLM.E2E" CreationDateTime="2026-01-01T00:00:00">
  <Study OID="S1">
    <MetaDataVersion OID="MDV.1" Name="Define VLM E2E" DefineVersion="2.1.0"
                     StandardName="SDTM-IG" StandardVersion="3.4">

      <!-- ItemGroupDefs (all grouped so the repeated elements stay contiguous for parsing). -->
      <ItemGroupDef OID="IG.LB" Name="LB" Domain="LB" Repeating="Yes" Purpose="Tabulation"
                    SASDatasetName="LB">
        <ItemRef ItemOID="IT.LB.LBTESTCD" OrderNumber="1" Mandatory="Yes" Role="Topic"/>
        <ItemRef ItemOID="IT.LB.LBSPEC" OrderNumber="2" Mandatory="No" Role="Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTRESC" OrderNumber="3" Mandatory="No" Role="Result Qualifier"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.QS" Name="QS" Domain="QS" Repeating="Yes" Purpose="Tabulation"
                    SASDatasetName="QS">
        <ItemRef ItemOID="IT.QS.QSCAT" OrderNumber="1" Mandatory="No" Role="Grouping Qualifier"/>
        <ItemRef ItemOID="IT.QS.QSTESTCD" OrderNumber="2" Mandatory="Yes" Role="Topic"/>
        <ItemRef ItemOID="IT.QS.QSTEST" OrderNumber="3" Mandatory="No" Role="Synonym Qualifier"/>
      </ItemGroupDef>

      <!-- ItemDefs (condition variables, parent result variables, and value-level ItemDefs). -->
      <ItemDef OID="IT.LB.LBTESTCD" Name="LBTESTCD" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Lab Test Code</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSPEC" Name="LBSPEC" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Specimen Type</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC" Name="LBSTRESC" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Character Result/Finding in Std Format</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.LB.LBSTRESC"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC.GLUC" Name="LBSTRESC_GLUC" DataType="float" Length="3"
               SignificantDigits="1">
        <Description><TranslatedText xml:lang="en">Glucose result</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC.PH" Name="LBSTRESC_PH" DataType="text" Length="7">
        <Description><TranslatedText xml:lang="en">Urine pH category</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.PHCAT"/>
      </ItemDef>
      <ItemDef OID="IT.QS.QSCAT" Name="QSCAT" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Category of Question</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.QS.QSTEST" Name="QSTEST" DataType="text" Length="40">
        <Description><TranslatedText xml:lang="en">Question Name</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.QS.QSTESTCD" Name="QSTESTCD" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Question Short Name</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.QS.QSTESTCD"/>
      </ItemDef>
      <ItemDef OID="IT.QS.QSTESTCD.FUNC" Name="QSTESTCD_FUNC" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Functional test code</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.QSFUNC"/>
      </ItemDef>

      <!-- ValueListDefs. -->
      <def:ValueListDef OID="VL.LB.LBSTRESC">
        <ItemRef ItemOID="IT.LB.LBSTRESC.GLUC" OrderNumber="1" Mandatory="Yes">
          <def:WhereClauseRef WhereClauseOID="WC.LB.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.LBSTRESC.PH" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.LB.PH.URINE"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.QS.QSTESTCD">
        <ItemRef ItemOID="IT.QS.QSTESTCD.FUNC" OrderNumber="1" Mandatory="Yes">
          <def:WhereClauseRef WhereClauseOID="WC.QS.FUNC"/>
        </ItemRef>
      </def:ValueListDef>

      <!-- WhereClauseDefs (a simple condition, a compound AND condition, and the QS condition). -->
      <def:WhereClauseDef OID="WC.LB.GLUC">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD">
          <CheckValue>GLUC</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.LB.PH.URINE">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD">
          <CheckValue>PH</CheckValue>
        </RangeCheck>
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.LB.LBSPEC">
          <CheckValue>URINE</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.QS.FUNC">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.QS.QSCAT">
          <CheckValue>FUNC</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>

      <!-- CodeLists. -->
      <CodeList OID="CL.PHCAT" Name="pH Category" DataType="text">
        <CodeListItem CodedValue="ACIDIC">
          <Decode><TranslatedText xml:lang="en">Acidic</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C001"/>
        </CodeListItem>
        <CodeListItem CodedValue="NEUTRAL">
          <Decode><TranslatedText xml:lang="en">Neutral</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C002"/>
        </CodeListItem>
        <CodeListItem CodedValue="BASIC">
          <Decode><TranslatedText xml:lang="en">Basic</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C003"/>
        </CodeListItem>
        <Alias Context="nci:ExtCodeID" Name="C99999"/>
      </CodeList>
      <CodeList OID="CL.QSFUNC" Name="Functional Test Code" DataType="text">
        <CodeListItem CodedValue="WALK">
          <Decode><TranslatedText xml:lang="en">Walk Test</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C201"/>
        </CodeListItem>
        <CodeListItem CodedValue="GRIP">
          <Decode><TranslatedText xml:lang="en">Grip Strength</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C202"/>
        </CodeListItem>
        <Alias Context="nci:ExtCodeID" Name="C88888"/>
      </CodeList>
    </MetaDataVersion>
  </Study>
</ODM>
