####
# Project-wide Lombok configuration. Lombok is used as a compile-time
# annotation processor across every module.
####

###
# Lombok does not natively support java.lang.System.Logger, so we declare
# it as a custom logger. @CustomLog on a class will then inject a static
# `LOGGER` field of type java.lang.System.Logger.
###

lombok.log.custom.declaration = java.lang.System.Logger java.lang.System.getLogger(NAME)
lombok.log.fieldName = LOGGER

###
# Jackson 2 is the JSON binding used project-wide; tell @Jacksonized to
# emit Jackson 2 conventions.
###

lombok.jacksonized.jacksonVersion += 2

###
# NullAway rollout: emit JSpecify nullability annotations
# (org.jspecify.annotations.NonNull / @Nullable) onto Lombok-generated
# members (@Value / @Builder / @Getter / @Setter) so NullAway sees correct
# contracts on generated code.
###

lombok.addNullAnnotations = jspecify
